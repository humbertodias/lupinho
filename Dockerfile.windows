FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    make \
    gcc-mingw-w64-x86-64 \
    libz-mingw-w64-dev \
    patch \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
COPY . /work/
RUN patch -d /work/src/libs/linux/lua-5.5.1 -p1 \
    < /work/src/libs/linux/lua-5.5.1-binary-literals.patch
RUN make -C /work/src windows
