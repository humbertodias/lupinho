FROM emscripten/emsdk:latest

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    patch zip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /lupinho
COPY . /lupinho/
RUN patch -d /lupinho/src/libs/linux/lua-5.5.1 -p1 \
    < /lupinho/src/libs/lua-5.5.1-binary-literals.patch
# Install Lua 5.5.1
RUN make -C /lupinho/src/libs/linux/lua-5.5.1 linux
ENV PATH=$PATH:/lupinho/src/libs/linux/lua-5.5.1/src
RUN make -C /lupinho/src web
